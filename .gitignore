# --- Environment / secrets ---
# Never commit real secrets. Commit only *.example files.
.env
.env.*
!.env.example
!.env.sample

# --- Deno / Fresh build ---
_fresh/
# Local Deno KV data (file-backed database)
kv/
# Vite cache and build output
.vite/
dist/
dist-ssr/

# --- npm / node ---
node_modules/
package-lock.json
.pnp
# Generated npm CLI bundle
npm/bin/vailnote-core.mjs
.pnp.js
*.tgz

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Test / coverage ---
coverage/
.nyc_output/
*.lcov
.tmp/

# --- OS ---
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~

# --- Editors / IDEs (only ignore local, non-shared files) ---
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tailwind.json
*.code-workspace

